# Copy to .env.local (git-ignored). Local-dev values only; see infra/keycloak/sentinel-realm.json.
NEXTAUTH_URL=http://localhost:3000
# Encrypts the session cookie. Generate your own: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
KEYCLOAK_ISSUER=http://localhost:8180/realms/sentinel
KEYCLOAK_CLIENT_ID=sentinel-console
KEYCLOAK_CLIENT_SECRET=sentinel-console-dev-secret
# Every API call goes through the gateway
GATEWAY_URL=http://localhost:8080

# Sentinel console settings for `npm run dev`.
# Copy this file to .env.local (git-ignored):   cp .env.example .env.local
# Values below are for the local docker-compose stack only (see infra/keycloak/sentinel-realm.json).

# Where the console itself runs
NEXTAUTH_URL=http://localhost:3000

# Encrypts the session cookie. REQUIRED: replace with your own random value, e.g. the output of
#   openssl rand -base64 32
# Changing it later simply signs everyone out.
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Keycloak realm and the console's client
KEYCLOAK_ISSUER=http://localhost:8180/realms/sentinel
KEYCLOAK_CLIENT_ID=sentinel-console
KEYCLOAK_CLIENT_SECRET=sentinel-console-dev-secret
# Only when the console runs in Docker: how the container reaches Keycloak. Leave empty for npm run dev.
KEYCLOAK_INTERNAL_ISSUER=

# The API gateway: GATEWAY_URL is used by the console server, GATEWAY_PUBLIC_URL for links in the browser
GATEWAY_URL=http://localhost:8080
GATEWAY_PUBLIC_URL=http://localhost:8080
